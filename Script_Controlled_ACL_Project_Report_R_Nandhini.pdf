q q BT 9 TL/F1 7.5 Tf 1 0 0 1 225.8703 25.51181 Tm (Script-Controlled ACL | Ramya V | Page 15)Tj T* ET Q q 1 0 0 1 57.02362 765.8661 cm 0 0 0 rg BT 19 TL/F2 15 Tf 1 0 0 1 0 4 Tm (11. APPENDIX)Tj T* ET Q q 1 0 0 1 57.02362 741.8661 cm 0 0 0 rg BT 16 TL/F2 12 Tf 1 0 0 1 0 4 Tm (Source Code \(Illustrative Prototype\))Tj T* ET Q q 1 0 0 1 57.02362 232.8661 cm 0 0 0 rg BT 9 TL/F5 7.2 Tf 1 0 0 1 8 496.8 Tm (# app.py)Tj T* (from flask import Flask, request, jsonify)Tj T* T* (app = Flask\(__name__\))Tj T* T* (USERS = {)Tj T* (    "ramya": {"department": "IT"},)Tj T* (    "arun": {"department": "CSE"})Tj T* (})Tj T* T* (RECORDS = {)Tj T* (    101: {"title": "IT Project Report", "department": "IT"},)Tj T* (    102: {"title": "CSE Project Report", "department": "CSE"},)Tj T* (    103: {"title": "General Notice", "department": "GENERAL"})Tj T* (})Tj T* T* (def record_acl\(user, record\):)Tj T* (    # Field-value based authorization)Tj T* (    if not user or not record:)Tj T* (        return False)Tj T* T* (    department = record.get\("department"\))Tj T* (    user_department = user.get\("department"\))Tj T* T* (    # General records are readable by authenticated users.)Tj T* (    if department == "GENERAL":)Tj T* (        return True)Tj T* T* (    # Restricted records require matching department.)Tj T* (    return department == user_department)Tj T* T* (@app.get\("/record/<int:record_id>"\))Tj T* (def get_record\(record_id\):)Tj T* (    username = request.args.get\("user"\))Tj T* (    user = USERS.get\(username\))Tj T* (    record = RECORDS.get\(record_id\))Tj T* T* (    if not user:)Tj T* (        return jsonify\({"error": "Authentication required"}\), 401)Tj T* T* (    if not record:)Tj T* (        return jsonify\({"error": "Record not found"}\), 404)Tj T* T* (    allowed = record_acl\(user, record\))Tj T* T* (    # In production, write this decision to an audit log.)Tj T* (    if not allowed:)Tj T* (        return jsonify\({"error": "Access denied"}\), 403)Tj T* T* (    return jsonify\({)Tj T* (        "message": "Access granted",)Tj T* (        "record": record)Tj T* (    }\), 200)Tj T* T* (if __name__ == "__main__":)Tj T* (    app.run\(debug=True\))Tj T* ET Q q 1 0 0 1 57.02362 208.8661 cm 0 0 0 rg BT 16 TL/F2 12 Tf 1 0 0 1 0 4 Tm T* ET Q q 1 0 0 1 57.02362 174.8661 cm 0 0 0 rg BT 14 TL/F1 9.5 Tf 1 0 0 1 0 18.5 Tm[-26621.999]TJ (The prototype uses a small illustrative in-memory)Tj T*[-26514.997]TJ (without depending on an external dataset.)Tj T* ET Q q 1 0 0 1 57.02362 151.8661 cm 0 0 0 rg BT 16 TL/F2 12 Tf 1 0 0 1 0 4 Tm T* ET Q q 1 0 0 1 57.02362 117.8661 cm 0 0 0 rg BT 14 TL/F1 9.5 Tf 1 0 0 1 0 18.5 Tm[-26509.999]TJ (These fields should be replaced with the team's actual)Tj T* T* ET Q q 1 0 0 1 57.02362 94.86614 cm 0 0 0 rg BT 16 TL/F2 12 Tf 1 0 0 1 0 4 Tm (Project Details)Tj T* ET Q Q
